# Production Environment Variables
ENVIRONMENT=production

# Rate Limiting
APP_RATE_LIMIT_PER_MINUTE=60
APP_RATE_LIMIT_PER_HOUR=500

# File Upload Limits
APP_MAX_UPLOAD_MB=50
APP_SUBPROCESS_TIMEOUT=900
APP_MAX_CONCURRENCY=8

# CORS Settings
APP_ALLOWED_ORIGINS=https://pdfislemleri.com,https://www.pdfislemleri.com

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/pdf-tools-api.log

# Security
SECURE_HEADERS=true
CSP_ENABLED=true
