# Production Environment Variables Example
# Copy this file to .env.production and fill in your values

ENVIRONMENT=production

# Application Settings
APP_MAX_UPLOAD_MB=50
APP_SUBPROCESS_TIMEOUT=900
APP_MAX_CONCURRENCY=8
APP_RATE_LIMIT_PER_MINUTE=60
APP_RATE_LIMIT_PER_HOUR=500
APP_ALLOWED_ORIGINS=*

# Python Settings
PYTHONPATH=/app
PYTHONHASHSEED=random
PYTHONOPTIMIZE=1

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/pdf-tools-api/app.log

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALLOWED_HOSTS=*

# Database (if needed in future)
# DATABASE_URL=postgresql://user:password@localhost/dbname

# Redis (if needed in future)
# REDIS_URL=redis://localhost:6379

# Monitoring
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true

# Email (if needed in future)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# External Services (if needed in future)
# GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
# SENTRY_DSN=your-sentry-dsn
