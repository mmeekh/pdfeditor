# Local test için basit Caddyfile
localhost:80 {
    root * /srv
    
    # CSS dosyaları
    handle /css/* {
        header Content-Type "text/css; charset=utf-8"
        file_server
    }
    
    # JS dosyaları  
    handle /js/* {
        header Content-Type "application/javascript; charset=utf-8"
        file_server
    }
    
    # Görsel dosyalar
    handle /icons/* {
        header Content-Type "image/webp"
        file_server
    }
    
    handle /images/* {
        header Content-Type "image/webp"
        file_server
    }
    
    handle /cardbgs/* {
        header Content-Type "image/webp"
        file_server
    }
    
    # JSON dosyaları
    handle /js/structured-data/* {
        header Content-Type "application/json; charset=utf-8"
        file_server
    }
    
    # API yönlendirmesi
    handle /api/* {
        reverse_proxy api:2000
    }
    
    # Diğer statik dosyalar
    handle {
        file_server
        try_files {path} {path}.html /index.html
    }
}
