{
  "name": "pdf-tools-frontend",
  "version": "1.0.0",
  "description": "PDF Tools Frontend with Tailwind CSS",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./static/css/tailwind.css --watch",
    "build:css:prod": "tailwindcss -i ./src/input.css -o ./static/css/tailwind.css --minify"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32"
  }
}
