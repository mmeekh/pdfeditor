{
	# ACME e-posta (ENV: EMAIL)
	email {env.EMAIL}
	# İstersen admin portunu kapatabilir/özelleştirebilirsin:
	# admin off
}

# www → apex (kalıcı yönlendirme)
www.pdfislemleri.com {
	redir https://pdfislemleri.com{uri} permanent
}

pdfislemleri.com {
	# Sıkıştırma
	encode zstd gzip

	# --- ÖNCELİK: API PROXY MATCHER'LARI ---
	# Not: API bloklarını statiklerden ÖNCE tanımladık.
	@api path /api/* /download/* /health /version /docs* /openapi.json /redoc*
	handle @api {
		# Büyük yüklemeler için sınır
		request_body {
			max_size 100MB
		}
		# Backend API servisine yönlendir
		reverse_proxy api:2000
		# API yanıtlarında cache kapalı olsun
		header {
			Cache-Control "no-store"
		}
	}

	# --- GÜVENLİK BAŞLIKLARI ---
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

		# (İsteğe bağlı) CSP — kullandığın CDN'lere göre düzenle
		# Content-Security-Policy "
		# 	default-src 'self';
		# 	script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: data: https://www.googletagmanager.com https://cdn.tailwindcss.com https://cdnjs.cloudflare.com;
		# 	style-src  'self' 'unsafe-inline' blob: data: https://fonts.googleapis.com https://cdnjs.cloudflare.com;
		# 	font-src   'self' blob: data: https://fonts.gstatic.com https://cdnjs.cloudflare.com;
		# 	img-src    'self' blob: data: https:;
		# 	connect-src 'self' https://www.google-analytics.com;
		# 	frame-src  'none';
		# 	object-src 'none';
		# 	base-uri   'self';
		# 	form-action 'self';
		# 	upgrade-insecure-requests;
		# 	worker-src 'self' blob:;
		# 	child-src  'self' blob:;
		# 	media-src  'self' blob: data:
		# "
	}

	# --- STATİK SERVİS / SPA ROUTING ---
	# Site kökü (compose ile ./site → /srv bağlı)
	root * /srv

	# Ağır statikler için uzun cache
	@static {
		path_regexp static ^/(?:images|icons|cardbgs|css|js)/.*|.*\.(?:css|js|png|jpg|jpeg|webp|svg|ico|xml|txt|woff2?)$
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# HTML dosyaları cache'lenmesin
	@html path *.html
	header @html Cache-Control "no-store"

	# Dosya sunumu + SPA fallback
	handle {
		try_files {path} {path}.html /index.html
		file_server
	}

	# --- LOG ---
	log {
		output file /var/log/caddy/pdfislemleri_access.log
		format json
	}
}
